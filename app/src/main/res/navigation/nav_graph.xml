<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_graph">

    <include app:graph="@navigation/auth_graph"/>

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.habitrpg.feature.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/auth_graph"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_tasks"
        android:name="com.example.habitrpg.feature.tasks.TasksFragment"
        android:label="fragment_tasks"
        tools:layout="@layout/fragment_tasks">

        <action
            android:id="@+id/action_tasks_to_create_task"
            app:destination="@id/nav_create_task" />
    </fragment>

    <fragment
        android:id="@+id/nav_create_task"
        android:name="com.example.habitrpg.feature.tasks.CreateTaskFragment"
        android:label="fragment_create_task"
        tools:layout="@layout/fragment_create_task" />

    <fragment
        android:id="@+id/nav_shop"
        android:name="com.example.habitrpg.feature.shop.ShopFragment"
        android:label="fragment_shop"
        tools:layout="@layout/fragment_shop" />

    <fragment
        android:id="@+id/nav_social"
        android:name="com.example.habitrpg.feature.social.SocialFragment"
        android:label="fragment_social"
        tools:layout="@layout/fragment_social" />

    <fragment
        android:id="@+id/nav_progression"
        android:name="com.example.habitrpg.feature.progression.ProgressionFragment"
        android:label="fragment_progression"
        tools:layout="@layout/fragment_progression" />

</navigation>
