<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/register_email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/register_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/input_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/register_confirm_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/input_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/register_username"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/register_avatar" />

        <RadioGroup
            android:id="@+id/avatar_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/avatar_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_1" />

            <RadioButton
                android:id="@+id/avatar_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_2" />

            <RadioButton
                android:id="@+id/avatar_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_3" />

            <RadioButton
                android:id="@+id/avatar_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_4" />

            <RadioButton
                android:id="@+id/avatar_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatar_5" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register_button" />

    </LinearLayout>
</ScrollView>
