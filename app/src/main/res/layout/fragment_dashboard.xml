<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pregled sistema"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Osnovni pojmovi i funkcionalnosti su implementirani kroz MVI + Clean Architecture tok kao i login ekran."
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pojmovi: XP (napredak), PP (snaga), HP (boss energija), Novčići, Bedževi, Oprema, Etapa, Kvota i Nivo."
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Titule nivoa: 1) Početnik navika  2) Čuvar discipline  3) Gospodar ritma"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Funkcionalnosti naloga: registracija sa avatarom i verifikacionim email-om, prijava sa proverom aktivacije, pregled profila i izmena lozinke kroz repository sloj."
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Statistika: za sada je pripremljena osnova modela/profila (XP, level, PP, coins, badges, equipment) koja može direktno da se proširi grafikonima i misijama."
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
