<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101426"
    android:fillViewport="true"
    tools:context=".feature.bossbattle.BossBattleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/boss_screen_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_boss_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#EAC75A"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Boss #1" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1D2542"
            app:cardCornerRadius="20dp"
            app:strokeColor="#44FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_boss"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/boss_illustration"
                    android:src="@drawable/ic_boss_idle" />

                <TextView
                    android:id="@+id/tv_boss_hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@android:color/white"
                    tools:text="HP bosa: 120 / 200" />

                <ProgressBar
                    android:id="@+id/progress_boss_hp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:max="200"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_boss_hp_progress" />

                <TextView
                    android:id="@+id/tv_user_pp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@android:color/white"
                    tools:text="PP korisnika: 35" />

                <ProgressBar
                    android:id="@+id/progress_user_pp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:max="200"
                    android:progress="35"
                    android:progressDrawable="@drawable/bg_user_pp_progress" />

                <TextView
                    android:id="@+id/tv_chance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#9BD0FF"
                    tools:text="Šansa pogotka: 68%" />

                <TextView
                    android:id="@+id/tv_attempts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#E6CFFF"
                    tools:text="Preostali napadi: 5 od 5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shop"
                        app:tint="#EAC75A" />

                    <TextView
                        android:id="@+id/tv_equipment_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@android:color/white"
                        tools:text="Aktivna oprema: nema" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_equipment"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/boss_equipment_button"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_attack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#E84B4B"
                    android:text="@string/boss_attack_button"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/tv_battle_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#D4DAF0"
                    tools:text="Borba je počela" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chest_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#24335A"
            app:cardCornerRadius="20dp"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_chest"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="@string/boss_chest_cd"
                    android:src="@drawable/ic_chest_closed" />

                <TextView
                    android:id="@+id/tv_chest_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@android:color/white"
                    tools:text="Protresi uređaj da otvoriš kovčeg" />

                <TextView
                    android:id="@+id/tv_rewards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFE188"
                    tools:text="Nagrada: 200 novčića" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
