<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F1020"
    android:padding="16dp"
    tools:context=".feature.progression.BossBattleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/boss_battle_screen_title"
            android:textColor="#FFD54F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1A1B2F"
            app:cardCornerRadius="18dp"
            app:strokeColor="#55FF5252"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_boss_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFCDD2"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Drevni Bos #1" />

                <ImageView
                    android:id="@+id/iv_boss"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/progression_boss_image"
                    android:src="@drawable/ic_social" />

                <TextView
                    android:id="@+id/tv_boss_hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFCDD2"
                    tools:text="HP bosa: 200/200" />

                <ProgressBar
                    android:id="@+id/progress_boss_hp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="200"
                    android:progressTint="#E53935" />

                <TextView
                    android:id="@+id/tv_power"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#90CAF9"
                    tools:text="PP u borbi: 42" />

                <ProgressBar
                    android:id="@+id/progress_power"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="42"
                    android:progress="42"
                    android:progressTint="#1E88E5" />

                <TextView
                    android:id="@+id/tv_equipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#E0E0E0"
                    tools:text="Aktivna oprema: Plašt" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_equipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/progression_activate_equipment"
                    android:textColor="#E0E0E0" />

                <TextView
                    android:id="@+id/tv_hit_chance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF59D"
                    tools:text="Šansa za pogodak: 68%" />

                <TextView
                    android:id="@+id/tv_attempts_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF59D"
                    tools:text="Preostali napadi: 5/5" />

                <Button
                    android:id="@+id/btn_attack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/progression_attack_button" />

                <TextView
                    android:id="@+id/tv_battle_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF"
                    tools:text="Boss encounter je aktivan." />

                <ImageView
                    android:id="@+id/iv_chest"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/progression_chest"
                    android:src="@drawable/ic_shop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_rewards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#A5D6A7"
                    android:visibility="gone"
                    tools:text="Nagrade: 200 novčića, Odeća" />

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#EF9A9A"
                    android:visibility="gone"
                    tools:text="Greška" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
